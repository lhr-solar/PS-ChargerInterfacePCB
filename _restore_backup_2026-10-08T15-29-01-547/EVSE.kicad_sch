	(text "Vout = Vin* ((R13+R21)/(R13+R21+R12))\nVout/Vin = 3/12 = 0.25\nVin = 12V\nVout = 3V\n\n\nR12 = \n0.25(R12+R13+R21)=R13+R21\nR12 = 3(R13+R21)\nR13 + R21 = 15.1k ohms, R12 = 45.3\n\nVout = 12*(15.1k/45.3k+15.1k) = 3V"
		(exclude_from_sim no)
		(at 39.878 67.31 0)
		(effects
